{
  "$defs": {
    "EnergyWaste": {
      "description": "E_waste = P_idle x PUE x T, reported for the observed window and a monthly baseline.",
      "properties": {
        "e_waste_kwh_monthly": {
          "minimum": 0,
          "title": "E Waste Kwh Monthly",
          "type": "number"
        },
        "e_waste_kwh_observed": {
          "minimum": 0,
          "title": "E Waste Kwh Observed",
          "type": "number"
        },
        "idle_hours_observed": {
          "minimum": 0,
          "title": "Idle Hours Observed",
          "type": "number"
        },
        "p_idle_kw": {
          "minimum": 0,
          "title": "P Idle Kw",
          "type": "number"
        },
        "pue": {
          "minimum": 1.0,
          "title": "Pue",
          "type": "number"
        }
      },
      "required": [
        "p_idle_kw",
        "pue",
        "idle_hours_observed",
        "e_waste_kwh_observed",
        "e_waste_kwh_monthly"
      ],
      "title": "EnergyWaste",
      "type": "object"
    },
    "Exemption": {
      "properties": {
        "exempt": {
          "default": false,
          "title": "Exempt",
          "type": "boolean"
        },
        "tag_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag Key"
        },
        "tag_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag Value"
        }
      },
      "title": "Exemption",
      "type": "object"
    },
    "IdleState": {
      "description": "Detection verdict.\n\nUNKNOWN is deliberate and load-bearing: missing or sparse telemetry is *not* idle.\nA resource is only IDLE/ORPHANED on positive evidence, because the enforcement\nlayer can snapshot and eventually delete what this layer flags.",
      "enum": [
        "active",
        "stopped",
        "idle",
        "orphaned",
        "exempt",
        "unknown"
      ],
      "title": "IdleState",
      "type": "string"
    },
    "LifecycleState": {
      "description": "Provider power/attachment states collapsed to one vocabulary.",
      "enum": [
        "running",
        "stopped",
        "attached",
        "unattached",
        "other"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "Provider": {
      "enum": [
        "aws",
        "gcp",
        "azure"
      ],
      "title": "Provider",
      "type": "string"
    },
    "ResourceIdentity": {
      "description": "What a provider normalizer produces, before telemetry and verdict are attached.",
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "lifecycle": {
          "$ref": "#/$defs/LifecycleState"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "provider_state": {
          "title": "Provider State",
          "type": "string"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "resource_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Type"
        },
        "size_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Gb"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tags",
          "type": "object"
        }
      },
      "required": [
        "provider",
        "account_id",
        "resource_id",
        "kind",
        "name",
        "region",
        "provider_state",
        "lifecycle"
      ],
      "title": "ResourceIdentity",
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "vm",
        "disk"
      ],
      "title": "ResourceKind",
      "type": "string"
    },
    "Telemetry": {
      "description": "Normalized utilization signals over the observation window.\n\nCPU is always percent (0-100); GCP reports a 0-1 fraction and is converted in the\nGCP normalizer. Network is always MB/day (1 MB = 1024*1024 bytes), in + out combined.\n``None`` means \"no data\", never \"zero\".",
      "properties": {
        "coverage": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "cpu_average": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Average"
        },
        "cpu_maximum": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Maximum"
        },
        "network_mb_per_day": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network Mb Per Day"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "window_start",
        "window_end"
      ],
      "title": "Telemetry",
      "type": "object"
    }
  },
  "$id": "idleness-record.v1.0",
  "description": "One row of the Idleness Schema.",
  "properties": {
    "energy": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnergyWaste"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "exemption": {
      "$ref": "#/$defs/Exemption"
    },
    "identity": {
      "$ref": "#/$defs/ResourceIdentity"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/IdleState"
    },
    "telemetry": {
      "anyOf": [
        {
          "$ref": "#/$defs/Telemetry"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "identity",
    "state",
    "reason",
    "evaluated_at"
  ],
  "title": "IdlenessRecord",
  "type": "object"
}
